# Cloudflare Pages: кеш у браузері.
# CSS і JS підключені з ?v=… — при зміні версії браузер усе одно бере новий файл.
/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable
# Фото й лого: місяць (якщо файл замінити під тим самим ім'ям — оновиться не одразу)
/assets/*
  Cache-Control: public, max-age=2592000
